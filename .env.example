# Скопіюйте цей файл у .env і вкажіть власні значення.
# Copy this file to .env and fill in your own values.
#
# Отримати токен бота: напишіть @BotFather в Telegram -> /newbot
# Get your bot token: message @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=

# Отримати chat_id: напишіть своєму боту будь-що, потім відкрийте
# https://api.telegram.org/bot<TOKEN>/getUpdates і знайдіть "chat":{"id": ...}
# Get your chat_id: message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and find "chat":{"id": ...}
TELEGRAM_CHAT_ID=
